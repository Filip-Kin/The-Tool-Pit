# Database
DATABASE_URL=postgresql://toolpit:toolpit@localhost:5432/toolpit

# Redis
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_URL=http://localhost:3000

# Auth (admin dashboard)
ADMIN_SECRET=change-me-in-production

# Anonymous voting
VOTE_COOKIE_SECRET=change-me-32-chars-minimum-secret

# GitHub (for connector rate limits)
GITHUB_TOKEN=ghp_your_token_here

# AI enrichment
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cloudflare Turnstile (optional, for suspicious vote detection)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

#TBA (FRC events)
TBA_API_KEY=

#TOA (FTC events, self-hosted Orange Alliance)
TOA_API_KEY=
TOA_APPLICATION_ORIGIN=
#TOA_API_BASE=https://api.theorangealliance.org
# --- Discord: the approvals channel ---
# The FRC.Tools bot posts every submission that needs a decision and seeds it
# with ✅ ❌. Anyone holding DISCORD_DEV_ROLE_ID decides by reacting; the
# worker relays that to the site, which runs the same code as the admin button
# and edits the post. Set all four on BOTH the web and worker services.
DISCORD_BOT_TOKEN=
DISCORD_APPROVALS_CHANNEL_ID=
DISCORD_DEV_ROLE_ID=
# Shared secret for /api/internal/moderate. Unset = the route is a 404.
INTERNAL_API_SECRET=
# Only if the worker should reach the web app on a shorter path than NEXT_PUBLIC_URL.
WEB_INTERNAL_URL=
# Fallback when the bot variables are unset: plain webhook, no reactions.
DISCORD_WEBHOOK=

# --- Accounts (Firebase Auth, shared by all four verticals) ---
# The web API key is public by design; access control is server-side ID-token
# verification plus the project's authorised-domain list.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auth.frc.tools
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-tool-pit
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Signs our own session cookie. 32 characters minimum.
SESSION_SECRET=change-me-32-chars-minimum-secret

# --- Grants: notification email ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM=

# --- Grants: web-search discovery sweeps ---
# The key enforces no monthly ceiling of its own, so this cap is the only
# thing standing between a bug and a bill. Queries beyond it are skipped and
# logged, never silently dropped.
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_QUERY_CAP=1800

# The one address the default onboarding@resend.dev sender is allowed to reach
# while no domain is verified. Leave blank once RESEND_FROM is a real domain.
RESEND_SANDBOX_OWNER=

# --- Vertical origins ---
# Only needed where the verticals are not on subdomains of NEXT_PUBLIC_URL, so
# a dev box on localhost ports. The worker needs NEXT_PUBLIC_URL and
# NEXT_PUBLIC_GRANTS_URL too: alert emails build their links from both.
NEXT_PUBLIC_PHOTOS_URL=
NEXT_PUBLIC_FIELDS_URL=
NEXT_PUBLIC_GRANTS_URL=

# --- Grants: discovery caps ---
# Both optional. Left unset the connectors use 24 queries per web-search run
# and a rotating slice of 120 teams per sponsor run.
GRANT_WEB_SEARCH_MAX_QUERIES=
GRANT_SPONSOR_MAX_TEAMS=

# Optional: SmugMug read-only browse key. Falls back to the public in-page key when unset.
#SMUGMUG_API_KEY=
