{
  "name": "@the-tool-pit/db",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/seed.ts",
    "db:seed-tools": "bun src/seed-tools.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "bun": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./field-enums": {
      "bun": "./src/field-enums.ts",
      "default": "./dist/field-enums.js"
    },
    "./grant-enums": {
      "bun": "./src/grant-enums.ts",
      "default": "./dist/grant-enums.js"
    },
    "./event-enums": {
      "bun": "./src/event-enums.ts",
      "default": "./dist/event-enums.js"
    },
    "./robot-code-enums": {
      "bun": "./src/robot-code-enums.ts",
      "default": "./dist/robot-code-enums.js"
    },
    "./human-edited": {
      "bun": "./src/human-edited.ts",
      "default": "./dist/human-edited.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./tool-enums": {
      "bun": "./src/tool-enums.ts",
      "default": "./dist/tool-enums.js"
    },
    "./audience-enums": {
      "bun": "./src/audience-enums.ts",
      "default": "./dist/audience-enums.js"
    },
    "./crawl-connectors": {
      "bun": "./src/crawl-connectors.ts",
      "default": "./dist/crawl-connectors.js"
    },
    "./slug": {
      "bun": "./src/slug.ts",
      "default": "./dist/slug.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
